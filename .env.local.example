# ============================================================
# jobapp.best Environment Variables
# NEVER committed .env.local to my GitHub
# ============================================================

# Supabase (supabase.com → project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

# Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AFRICA_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_KEY=pk_live_...

# Job boards
REED_API_KEY=your-reed-key
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
JOOBLE_API_KEY=your-jooble-key

# Flutterwave (flutterwave.com → Settings → API)
FLUTTERWAVE_SECRET_KEY=FLWSECK-...
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-...
FLUTTERWAVE_PLAN_ID=your-plan-id
FLUTTERWAVE_WEBHOOK_SECRET=your-random-secret

# Email (for auto-apply feature)
RESEND_API_KEY=re_...

# Encryption key for storing email app passwords securely
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# App URL
NEXT_PUBLIC_APP_URL=https://jobapp.best
